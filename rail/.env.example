# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# ESP32 Device Authentication Secret
ESP32_SECRET_KEY=smartrail_esp32_super_secret_key_2026

# Railway API Key (Replace with real provider key if available, e.g. RapidAPI / IRCTC)
RAILWAY_API_KEY=mock_railway_api_key_sih
RAILWAY_API_PROVIDER=mock

# Database Configuration (Defaults to embedded SQLite for zero-config run)
DATABASE_TYPE=sqlite
DATABASE_FILE=./data/smartrail.sqlite

# Admin Secret Key
ADMIN_SECRET_KEY=smartrail_admin_sih_2026
