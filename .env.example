# ==========================================
# RailTrack India - Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Railway API Provider Configuration
# Set to 'true' to run with the built-in realistic mock data provider (No API key needed!)
# Set to 'false' to call external live Indian Railways APIs
USE_MOCK_RAILWAY_API=true

# External Railway API Credentials (RapidAPI / IRCTC API / RailwayAPI)
# Leave blank when USE_MOCK_RAILWAY_API=true
RAILWAY_API_KEY=your_railway_api_key_here
RAILWAY_API_BASE_URL=https://irctc1.p.rapidapi.com/api/v1
RAILWAY_API_HOST=irctc1.p.rapidapi.com

# In-Memory Cache TTL (in seconds)
CACHE_TTL_LIVE_STATUS=30
CACHE_TTL_SCHEDULE=3600

# Rate Limiting (Requests per 15-minute window per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
